# 複製為 .env 後填入（.env 已列在 .gitignore，不會被提交）。說明見 docs/OPERATIONS.md

# LLM（依序使用，至少填一個；全部沒有時報告改用模板）
NVIDIA_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# FinMind（FINMIND_TOKENS 可放多組，以逗號分隔輪流使用；都沒有時改用官方免費來源）
FINMIND_TOKEN=
FINMIND_TOKENS=

# Gmail 寄送報告（需開啟兩步驟驗證後建立應用程式密碼；收件人可用逗號分隔）
SMTP_USER=
SMTP_APP_PASSWORD=
REPORT_TO=

# 網站登入密碼（本機留空則不需登入）
APP_PASSWORD=

# 雲端設定用（scripts/setup_cloud.py）
HF_TOKEN=
GH_PAT=
